    <!--
        The JavaScript dependencies below are only used at build time: they are bundled with esbuild into
        the resulting jar, so the UI does not load anything from a CDN.
        Transitive versions of the org.mvnpm dependencies are pinned in the 'locker' profile. After changing
        any of the versions here, regenerate it using:
        mvn io.mvnpm:locker-maven-plugin:1.0.1:lock -Dunlocked
        The build fails if the lock does not match the resolved dependencies (see src/bundler/Bundle.java).
        The lock also contains the platform-specific esbuild and deno artifacts of the platform it was generated on;
        these are ignored by the check, but please generate the lock on linux-x64 to avoid unnecessary changes.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Conflicting version ranges (npm would install both), pick the newer one -->
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>clsx</artifactId>
                <version>2.1.1</version>
            </dependency>
            <!-- The version requested by graphiql (a release candidate) is not available on Maven Central -->
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>react-compiler-runtime</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>graphql-ws</artifactId>
                <version>${graphql-ws.version}</version>
                <!-- Server-side optional peer dependencies -->
                <exclusions>
                    <exclusion>
                        <groupId>org.mvnpm.at.fastify</groupId>
                        <artifactId>websocket</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.mvnpm</groupId>
